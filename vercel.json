{
  "env": {
    "DEPLOY_TARGET": "vercel"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://auth-service-one-eta.vercel.app/api/auth/:path*"
    },
    {
      "source": "/api/profile",
      "destination": "https://victorious-presence-production.up.railway.app/profile"
    }
  ]
}
