# =============================================================
# Book HTHON — Environment Variables Reference
# Copy this to .env and fill in your values.
# =============================================================

# ── Neon PostgreSQL ──
# Shared by auth-service, api/profile.js, and the FastAPI backend.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Auth Service (Vercel project: auth-service) ──
# BETTER_AUTH_SECRET: generate with `openssl rand -base64 32`
# BETTER_AUTH_URL: must be the FRONTEND origin (not auth-service's own URL)
#   so that session cookies are scoped to the domain the browser talks to.
BETTER_AUTH_SECRET=<your-secret>
BETTER_AUTH_URL=https://book-hthon.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://book-hthon.vercel.app
NODE_ENV=production

# ── Main Site (Vercel project: book-hthon) ──
# DATABASE_URL is used by api/profile.js (serverless profile endpoint).
AUTH_SERVICE_URL=https://auth-service-one-eta.vercel.app
BACKEND_API_URL=http://localhost:8000
DEPLOY_TARGET=vercel

# ── FastAPI Backend (optional — profile is now on Vercel) ──
# AUTH_SERVICE_URL: used by dependencies.py to validate sessions.
# CORS_ORIGINS: comma-separated list of allowed origins.
# AUTH_SERVICE_URL=https://auth-service-one-eta.vercel.app
# CORS_ORIGINS=http://localhost:3000,https://book-hthon.vercel.app

# ── RAG Chatbot (FastAPI backend) ──
COHERE_API_KEY=<your-cohere-key>
QDRANT_URL=<your-qdrant-cloud-url>
QDRANT_API_KEY=<your-qdrant-api-key>
DOCUSAURUS_URL=https://book-hthon.vercel.app
